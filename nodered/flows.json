    {
        "id": "v19b_function",
        "type": "function",
        "z": "v19b_tab",
        "name": "Лог в SQL + FAULT",
        "func": "const T = 3;\nconst ranges = {s1:[0,100], s2:[-20,80], s3:[2,400]};\nconst text = String(msg.payload).replace(/^\\uFEFF/, '');\nconst sql = [];\n\nfor (const line of text.split(/\\r?\\n/)) {\n    const parts = line.trim().split(/\\s+/);\n    const f = {};\n    for (const part of parts.slice(1)) {\n        const [key, value] = part.split('=');\n        f[key] = value;\n    }\n    const n = Number(f.n);\n    if (!Number.isInteger(n) || n < 1) continue;\n    const t = n * T;\n\n    if (parts[0] === 'DATA') {\n        for (const s of ['s1','s2','s3']) {\n            if (!f[s]) continue;\n            const v = Number(f[s]);\n            if (!Number.isFinite(v)) continue;\n            sql.push(`INSERT INTO readings(n,t_s,sensor,value) VALUES(${n},${t},'${s}',${v});`);\n            if (v < ranges[s][0] || v > ranges[s][1]) {\n                sql.push(`INSERT INTO events(n,t_s,type,message) VALUES(${n},${t},'FAULT','датчик ${s} вне диапазона');`);\n            }\n        }\n    }\n\n    if (parts[0] === 'EVENT' && ['THRESHOLD','NORMAL'].includes(f.type)) {\n        sql.push(`INSERT INTO events(n,t_s,type,message) VALUES(${n},${t},'${f.type}','');`);\n    }\n}\n\nif (!sql.length) {\n    node.warn('Нет строк DATA или EVENT для загрузки');\n    return null;\n}\n\nconst head = \"BEGIN;\\nDELETE FROM readings;\\nDELETE FROM events;\\nDELETE FROM sqlite_sequence WHERE name IN ('readings','events');\\n\";\nreturn [null, {payload: head + sql.join('\\n') + '\\nCOMMIT;\\n'}];",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
